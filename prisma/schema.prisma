generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SURVEYOR
  /// Acquisition team: walks buildings, records the contact person.
  ACQUISITION_AGENT
  /// Runs the acquisition team: creates agents, tracks their output.
  ACQUISITION_LEAD
  /// Oversight across BOTH registries: sees every building whoever logged it,
  /// and may add or edit any of them. Not a system administrator — no user,
  /// zone, operator or log management.
  SUPERVISOR
  /// Recruits and supports external referral partners. No building, zone or
  /// operator access at all — see partner-network.md §2.1.
  PARTNER_MANAGER
  /// Finance. Records that a partner has been paid what they earned
  /// (partner-network.md §6.2) and nothing else: no registry, no map, and
  /// none of the customers' personal details behind those earnings.
  ACCOUNTS
  /// Field-sales hierarchy (see docs .../2026-09-24-field-sales-design.md).
  /// Runs team leaders + sales executives; created by an ADMIN.
  SALES_MANAGER
  /// Reports to a SALES_MANAGER; runs a set of sales executives.
  TEAM_LEADER
  /// The field user: works the buildings assigned to them, records visits and
  /// raises customer inquiries.
  SALES_EXECUTIVE
  /// Visits societies to get fibre-laying permission; adds coverage buildings
  /// with the society-permission sheet and manages only their own.
  PERMISSION_EXECUTIVE
}

/// The state of a building's assignment to a sales user. Only one row per
/// building is ACTIVE at a time; a reassignment closes the old row (keeping the
/// history) and opens a new one.
enum AssignmentStatus {
  ACTIVE
  REASSIGNED
  UNASSIGNED
}

// How a sales lead (CustomerInquiry) is progressing. A lead starts NOT_CONTACTED;
// FOLLOW_UP carries a followUpAt date+time; COMPLETED = signed up / interested;
// NOT_INTERESTED = the customer declined.
enum InquiryStatus {
  NOT_CONTACTED
  FOLLOW_UP
  COMPLETED
  NOT_INTERESTED
}

enum FeasibleStatus {
  FEASIBLE
  PERMISSION_PENDING
  REJECTED
  SURVEY_PENDING
}

enum SurveyStatus {
  PENDING
  COMPLETED
}

enum PhotoType {
  ENTRANCE
  PERMISSION_LETTER
  ADDITIONAL
  /// Acquisition proof-of-visit: the agent's own selfie at the building.
  SELFIE
  /// The contact person the agent met.
  CONTACT_PERSON
}

/// Which team logged the building — keeps the two registries separable.
enum BuildingSource {
  COVERAGE
  ACQUISITION
  /// A Permission Executive's society (society permissions, phase 1) — hidden
  /// from the coverage registry, map, stats and sales views.
  PERMISSION
}

enum ContactDesignation {
  CHAIRMAN
  SECRETARY
  MANAGER
  OWNER
  TREASURER
  COMMITTEE_MEMBER
  WATCHMAN
  OTHER
}

model User {
  visitTasks        VisitTask[]  @relation("VisitTaskAssignee")
  visitTasksCreated VisitTask[]  @relation("VisitTaskCreatedBy")
  taskUploads       TaskUpload[] @relation("TaskUploadBy")
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  passwordHash  String
  role          Role          @default(SURVEYOR)
  isActive      Boolean       @default(true)
  /// Granted by an ADMIN on Users → Assign accesses. Lets a MANAGER, SURVEYOR
  /// or SUPERVISOR draw fiber and closures; ADMIN never needs it.
  canManageFiber Boolean      @default(false)
  /// Granted by an ADMIN on Users → Assign accesses. Lets a SURVEYOR edit the
  /// buildings THEY logged — never anyone else's, and never the permission
  /// record or the live flag. The other roles edit buildings by role already.
  canEditBuildings Boolean    @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  buildings     Building[]
  /// Zones a SURVEYOR may work in; unused for other roles.
  fibersCreated    Fiber[]    @relation("FiberCreatedBy")
  closuresCreated  Closure[]  @relation("ClosureCreatedBy")
  popsCreated      Pop[]      @relation("PopCreatedBy")
  splittersCreated Splitter[] @relation("SplitterCreatedBy")
  partnerBankEdits PartnerBankAccount[] @relation("PartnerBankEditor")
  assignedZones Zone[]        @relation("UserAssignedZones")
  /// City + pincodes an ACQUISITION_AGENT covers; unused for other roles.
  pincodes      UserPincode[]

  /// Field-sales hierarchy (unused for every non-sales role).
  /// managerId: the SALES_MANAGER a TEAM_LEADER / SALES_EXECUTIVE reports to.
  /// teamLeaderId: the TEAM_LEADER a SALES_EXECUTIVE reports to (nullable — a
  /// manager may hold an executive directly).
  managerId       String?
  manager         User?   @relation("SalesManagerReports", fields: [managerId], references: [id])
  reports         User[]  @relation("SalesManagerReports")
  teamLeaderId    String?
  teamLeader      User?   @relation("TeamLeaderReports", fields: [teamLeaderId], references: [id])
  teamMembers     User[]  @relation("TeamLeaderReports")
  assignmentsHeld  BuildingAssignment[] @relation("AssignmentHolder")
  assignmentsMade  BuildingAssignment[] @relation("AssignmentBy")
  visitsRecorded   BuildingVisit[]      @relation("VisitBy")
  inquiriesCreated CustomerInquiry[]    @relation("InquiryBy")
  teamMeetings     TeamMeeting[]        @relation("TeamMeetingBy")
  accompaniedVisits VisitCompanion[]    @relation("VisitCompanionUser")

  /// Partner network — see partner-network.md
  partnersOnboarded  Partner[]         @relation("PartnerOnboardedBy")
  partnerInvites     PartnerInvite[]   @relation("PartnerInvitesIssued")
  leadsAttributed    Lead[]            @relation("LeadEmployee")
  earningsAttributed PartnerEarning[]  @relation("EarningEmployee")
  partnerReferrals   PartnerReferral[] @relation("PartnerReferralEmployee")
  leadCalls          LeadCall[]        @relation("LeadCallBy")
  earningsMarkedPaid PartnerEarning[]  @relation("EarningPaidBy")
  paymentsRecorded   PartnerPayment[]  @relation("PaymentRecordedBy")
  appReleases        AppRelease[]      @relation("AppReleaseCreatedBy")
  permissionVisits   PermissionVisit[] @relation("PermissionVisitBy")
  societiesDecided   Building[]        @relation("BuildingApprovalDecidedBy")
  surveysSubmitted   SocietySurvey[]   @relation("SocietySurveySubmittedBy")
  surveysDecided     SocietySurvey[]   @relation("SocietySurveyDecidedBy")
}

/// One row per pincode an acquisition agent covers (within one city).
model UserPincode {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityId  String
  city    City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  pincode String

  @@unique([userId, pincode])
  @@index([cityId])
}

model BuildingType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model City {
  id        String        @id @default(cuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  operators Operator[]
  buildings Building[]
  agents    UserPincode[]
}

model Operator {
  id          String       @id @default(cuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  zones       Zone[]
  fiberRoutes FiberRoute[]
  fibers      Fiber[]
  /// Groups operators under a city; null for operators with no city yet.
  cityId      String?
  city        City?        @relation(fields: [cityId], references: [id], onDelete: SetNull)
}

model Zone {
  id            String     @id @default(cuid())
  name          String     @unique
  city          String
  /// Ordered polygon vertices [{ latitude, longitude }, ...], min 3 when set
  boundary      Json?
  createdAt     DateTime   @default(now())
  buildings     Building[]
  fibers        Fiber[]
  pops          Pop[]      @relation("PopZones")
  assignedUsers User[]     @relation("UserAssignedZones")
  /// Groups zones under an operator; null for zones with no operator yet.
  operatorId    String?
  operator      Operator?  @relation(fields: [operatorId], references: [id], onDelete: SetNull)
}

model FiberRoute {
  id         String    @id @default(cuid())
  name       String    @unique
  /// Typed polylines: [ { fiberType, points: [ {latitude, longitude}, ... ] }, ... ].
  /// fiberType: '2 core' … '48 core' (render color derives from it). A branch
  /// is a segment whose first point sits on another segment's vertex.
  segments   Json
  /// Field/asset identifier printed on the cable or duct.
  fiberId    String?
  /// 'IN' | 'OUT'.
  placement  String?
  /// Owning operator; null for shared/unassigned routes.
  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  remark     String?
  /// Upload URLs from our uploads API (photos of the laid fiber).
  images     Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

enum FiberPointType {
  WAYPOINT
  POP
  CLOSURE
  BUILDING
  SPLITTER
}

enum FiberStatus {
  PLANNED
  LIVE
  CUT
}

enum SplitterRatio {
  R1_2
  R1_4
  R1_6
  R1_8
  R1_16
}

enum SplitterLocation {
  S1
  S2
  S3
}

model Pop {
  id        String   @id @default(cuid())
  name      String   @unique
  latitude  Float
  longitude Float
  /// The zones this site serves. Whoever is assigned to ANY of these sees and
  /// may use the POP and its OLTs; the maker and ADMINs always do. Empty for
  /// POPs recorded before zones were kept — those stay maker/ADMIN-only.
  zones     Zone[]   @relation("PopZones")
  notes     String?
  /// Where the rack stands on site — floor, room, building. The map pin says
  /// where the POP is; this says where to walk once you are there.
  serverLocation String?
  /// '16U' | '20U' | '22U' | '27U' | '32U'
  rackSize       String?
  /// 'OK' | 'DAMAGED'
  rackCondition  String?
  /// Batteries on the UPS: 1, 2 or 4. Null means nothing recorded yet.
  upsBatteryCount Int?
  /// Photos of the rack, as upload-API URLs — same shape as Fiber.images.
  images    Json?
  /// Who made it. Only they and an ADMIN can see or change it. Null only for
  /// rows the migration could not trace to anyone — those are ADMIN's alone.
  createdById String?
  createdBy   User?    @relation("PopCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  olts      Olt[]
  devices   PopDevice[]
  points    FiberPoint[]
}

/// What kind of box a PopDevice is. OLTs are their own table — they carry PON
/// ports and the fibers that leave them; these three only carry an address or
/// a port count, so one table with a kind beats three near-identical ones.
enum PopDeviceKind {
  SWITCH
  MIKROTIK
  FMS
}

model PopDevice {
  id        String        @id @default(cuid())
  popId     String
  pop       Pop           @relation(fields: [popId], references: [id], onDelete: Cascade)
  kind      PopDeviceKind
  /// What it is called on site, if anything — "Switch 1", "Core MT".
  label     String?
  /// Required for a SWITCH or a MIKROTIK; an FMS is passive and has none.
  ipAddress String?
  /// FMS only: 12 | 24 | 48 | 96.
  portCount Int?
  /// SWITCH only: '1G' | '10G'.
  speed     String?
  /// What is written on the box — e.g. CRS326, RB4011.
  model     String?
  createdAt DateTime      @default(now())
  @@index([popId])
}

model Olt {
  id           String   @id @default(cuid())
  popId        String
  pop          Pop      @relation(fields: [popId], references: [id], onDelete: Cascade)
  name         String
  ponPortCount Int
  ipAddress    String?
  /// 'GPON' | 'EPON'
  type         String?
  /// What is written on the box — e.g. C320.
  model        String?
  createdAt    DateTime @default(now())
  fibers       Fiber[]
  buildings    Building[]
  @@unique([popId, name])
}

model Fiber {
  id         String      @id @default(cuid())
  name       String      @unique              // FIB-001…, editable
  coreCount  Int                               // 2 | 4 | 6 | 12 | 24 | 48
  cableType  String?
  status     FiberStatus @default(PLANNED)
  oltId      String?
  olt        Olt?        @relation(fields: [oltId], references: [id], onDelete: SetNull)
  ponPort    Int?
  cableTag   String?                           // phase-1 fiberId (asset tag on the cable)
  placement  String?                           // 'IN' | 'OUT'
  operatorId String?
  operator   Operator?   @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  /// The zone this cable runs in. Required on new fibers — the map's zone
  /// filter is only trustworthy if every fiber has one — but nullable, because
  /// the fibers drawn before this column existed have none. A surveyor may
  /// only pick a zone they are assigned to.
  zoneId     String?
  zone       Zone?       @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  notes      String?
  images     Json?                             // upload URLs from our uploads API only
  /// Who made it. Only they and an ADMIN can see or change it. Null only for
  /// rows the migration could not trace to anyone — those are ADMIN's alone.
  createdById String?
  createdBy   User?    @relation("FiberCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  points     FiberPoint[]
  segments   FiberSegment[]
  fedBy      SplitterOutput? @relation("SplitterOutputFiber")
  feeds      Splitter[]      @relation("SplitterInput")
  @@unique([oltId, ponPort])                    // one fiber per PON port
}

model FiberPoint {
  id         String         @id @default(cuid())
  fiberId    String
  fiber      Fiber          @relation(fields: [fiberId], references: [id], onDelete: Cascade)
  sequence   Int
  type       FiberPointType @default(WAYPOINT)
  latitude   Float                              // for typed points: a copy of the entity's position
  longitude  Float
  popId      String?
  pop        Pop?           @relation(fields: [popId], references: [id], onDelete: Restrict)
  closureId  String?
  closure    Closure?       @relation(fields: [closureId], references: [id], onDelete: Restrict)
  buildingId String?
  building   Building?      @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  splitterId String?
  splitter   Splitter?      @relation(fields: [splitterId], references: [id], onDelete: Restrict)
  segmentsFrom FiberSegment[] @relation("SegmentFrom")
  segmentsTo   FiberSegment[] @relation("SegmentTo")
  @@unique([fiberId, sequence])
  @@index([closureId])
  @@index([popId])
  @@index([buildingId])
  @@index([splitterId])
}

model FiberSegment {
  id              String     @id @default(cuid())
  fiberId         String
  fiber           Fiber      @relation(fields: [fiberId], references: [id], onDelete: Cascade)
  sequence        Int
  fromPointId     String
  fromPoint       FiberPoint @relation("SegmentFrom", fields: [fromPointId], references: [id], onDelete: Cascade)
  toPointId       String
  toPoint         FiberPoint @relation("SegmentTo",   fields: [toPointId],   references: [id], onDelete: Cascade)
  mapMeters       Float
  fiberLaidMeters Float?
  isCut           Boolean    @default(false)
  cutAt           DateTime?
  cutNote         String?
  @@unique([fiberId, sequence])
}

model Closure {
  id         String    @id @default(cuid())
  code       String    @unique               // CL-0001…
  latitude   Float
  longitude  Float
  kind       String?                         // Jumbo / Tiffin / Compass / FDC / PatchPanel (free text; older rows may hold anything)
  /// Which kind of cable this closure sits on: 'MAIN_SF' | 'SUB_SF' | 'DROP_CABLE'.
  fiberType  String?
  /// Tubes in the cable: 0–4.
  tubeCount  Int?
  /// Cores of the cable coming in and the one going out — the usual counts.
  inCoreCount  Int?
  outCoreCount Int?
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  notes      String?
  /// Photos: an array of upload-API URLs (stored canonical, served signed).
  images     Json?
  /// Who made it. Only they and an ADMIN can see or change it. Null only for
  /// rows the migration could not trace to anyone — those are ADMIN's alone.
  createdById String?
  createdBy   User?    @relation("ClosureCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  points     FiberPoint[]
  splitters  Splitter[]
}

model Splitter {
  id           String           @id @default(cuid())
  code         String           @unique       // S1, S2… minted from Splitter_code_seq
  latitude     Float                          // where it sits on the line
  longitude    Float
  /// Set only for the legacy "splitter attached to a closure" shape; a splitter
  /// placed on the line directly has none.
  closureId    String?
  closure      Closure?         @relation(fields: [closureId], references: [id], onDelete: Cascade)
  ratio        SplitterRatio
  location     SplitterLocation @default(S1)
  fiberType    String?                         // 'MAIN' | 'SUB'
  inputFiberId String?
  inputFiber   Fiber?           @relation("SplitterInput", fields: [inputFiberId], references: [id], onDelete: SetNull)
  /// Who made it. Only they and an ADMIN can see or change it. Null only for
  /// rows the migration could not trace to anyone — those are ADMIN's alone.
  createdById String?
  createdBy   User?    @relation("SplitterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  outputs      SplitterOutput[]
  points       FiberPoint[]
  @@index([inputFiberId])
}

model SplitterOutput {
  id           String    @id @default(cuid())
  splitterId   String
  splitter     Splitter  @relation(fields: [splitterId], references: [id], onDelete: Cascade)
  portNo       Int
  toFiberId    String?   @unique
  toFiber      Fiber?    @relation("SplitterOutputFiber", fields: [toFiberId], references: [id], onDelete: SetNull)
  toBuildingId String?
  toBuilding   Building? @relation(fields: [toBuildingId], references: [id], onDelete: SetNull)
  label        String?
  @@unique([splitterId, portNo])
}

model Building {
  visitTasks VisitTask[]
  id               String           @id @default(cuid())
  /// Google Place id. NOT globally unique: the same building can be added
  /// under more than one zone, because two operators can both serve it. The
  /// uniqueness that IS enforced — one row per place PER ZONE — is a partial
  /// expression index created in the migration, which Prisma cannot express.
  /// Do not put @unique back here.
  placeId          String?
  buildingName     String
  formattedAddress String
  latitude         Float
  longitude        Float
  /// Coverage buildings belong to a zone; acquisition buildings use
  /// city + pincode instead, so this is optional.
  zoneId           String?
  zone             Zone?            @relation(fields: [zoneId], references: [id])
  /// Set for ACQUISITION buildings (agents are mapped by city + pincode).
  cityId           String?
  city             City?            @relation(fields: [cityId], references: [id])
  pincode          String?
  source           BuildingSource   @default(COVERAGE)
  feasibleStatus   FeasibleStatus   @default(SURVEY_PENDING)
  surveyStatus     SurveyStatus     @default(PENDING)
  /// Fiber connection is live at this building (drives the green/red marker).
  isLive           Boolean          @default(false)
  createdById      String
  createdBy        User             @relation(fields: [createdById], references: [id])
  /// Which OLT + PON port(s) serve this building (set in bulk from the Buildings
  /// tab). Nullable OLT: existing buildings are unmapped until someone maps them.
  /// A building may use several PON ports; the OLT's zones are its POP's zones.
  oltId            String?
  olt              Olt?             @relation(fields: [oltId], references: [id], onDelete: SetNull)
  ponPorts         Int[]            @default([])
  /// Society permissions, phase 2 (PERMISSION rows only): 'PENDING' |
  /// 'APPROVED' | 'REJECTED' | null. An APPROVED society shows in every staff
  /// view like any building (src/lib/building-source.js).
  permissionApproval  String?
  /// The last reject reason — kept until the society is approved.
  approvalReason      String?
  approvalSubmittedAt DateTime?
  approvalDecidedAt   DateTime?
  approvalDecidedById String?
  approvalDecidedBy   User?     @relation("BuildingApprovalDecidedBy", fields: [approvalDecidedById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  details          BuildingDetails?
  permission       Permission?
  contact          BuildingContact?
  photos           Photo[]
  leads            Lead[]
  fiberPoints      FiberPoint[]
  splitterOutputs  SplitterOutput[]
  closures         Closure[]
  salesAssignments BuildingAssignment[]
  salesVisits      BuildingVisit[]
  salesInquiries   CustomerInquiry[]
  permissionVisits PermissionVisit[]
  societySurvey    SocietySurvey?

  @@index([latitude, longitude])
  @@index([source, createdById])
  @@index([source, permissionApproval])
}

/// A building handed to a sales user. The single ACTIVE row per building is its
/// current holder (a manager, team leader or executive); ancestors in the
/// hierarchy still see it. History is preserved — a reassignment closes the old
/// row rather than editing it. See the field-sales design spec.
model BuildingAssignment {
  id           String           @id @default(cuid())
  buildingId   String
  building     Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   User             @relation("AssignmentHolder", fields: [assignedToId], references: [id])
  assignedById String
  assignedBy   User             @relation("AssignmentBy", fields: [assignedById], references: [id])
  status       AssignmentStatus @default(ACTIVE)
  assignedAt   DateTime         @default(now())
  endedAt      DateTime?

  @@index([buildingId, status])
  @@index([assignedToId, status])
}

/// A recorded visit to a building by a sales user. A visit is separate from an
/// inquiry — someone visits many buildings and raises an inquiry only where a
/// customer is interested.
/// A check-in → work → check-out session at a building. `visitedAt` is the
/// check-in time; the visit is "open" until `checkOutAt` is set. Location is
/// captured by the browser at both ends (forced by the API), and a selfie is
/// the proof of presence.
model BuildingVisit {
  id          String            @id @default(cuid())
  buildingId  String
  building    Building          @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation("VisitBy", fields: [userId], references: [id])
  visitedAt   DateTime          @default(now())
  checkInLat  Float?
  checkInLng  Float?
  selfieUrl   String?
  checkOutAt  DateTime?
  checkOutLat Float?
  checkOutLng Float?
  note        String?
  activities  VisitActivity[]
  inquiries   CustomerInquiry[] @relation("InquiryVisit")
  /// A team leader's field visit records who they went with (their own sales
  /// executives) or that they went solo.
  wentSolo    Boolean           @default(false)
  companions  VisitCompanion[]

  @@index([userId, visitedAt])
  @@index([buildingId])
}

/// A sales executive a team leader took on a field visit.
model VisitCompanion {
  id      String        @id @default(cuid())
  visitId String
  visit   BuildingVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  userId  String
  user    User          @relation("VisitCompanionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([visitId, userId])
  @@index([userId])
}

/// The kind of field work done during a visit; more may be added later.
enum ActivityType {
  DESK
  UMBRELLA
  LIFT
}

/// One piece of field work logged during a visit (many per visit).
/// A kind of field work done during a visit. At most one row per type per visit
/// — it records THAT the work was done, not how many times, so the UI is a
/// no-count multi-select (Desk + Umbrella together is fine; clicking twice does
/// not stack).
model VisitActivity {
  id        String        @id @default(cuid())
  visitId   String
  visit     BuildingVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  type      ActivityType
  createdAt DateTime      @default(now())

  @@unique([visitId, type])
  @@index([visitId])
}

/// A lightweight customer inquiry raised in the field, for the calling team to
/// follow up. The building address is snapshotted so the record stands alone.
model CustomerInquiry {
  id           String   @id @default(cuid())
  buildingId   String
  building     Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User     @relation("InquiryBy", fields: [createdById], references: [id])
  customerName String
  phone        String
  email        String?
  address      String
  /// Lead progress. Starts NOT_CONTACTED; the sales person calls, then updates it.
  status       InquiryStatus @default(NOT_CONTACTED)
  /// When to follow up — set only while status is FOLLOW_UP.
  followUpAt   DateTime?
  createdAt    DateTime @default(now())
  /// Set when the inquiry was raised during a specific check-in session.
  visitId      String?
  visit        BuildingVisit? @relation("InquiryVisit", fields: [visitId], references: [id], onDelete: SetNull)

  @@index([buildingId])
  @@index([createdById, createdAt])
  @@index([visitId])
}

/// A team leader's daily morning meeting — a photo, the location, and the time.
/// One per team leader per calendar day (logging again the same day replaces
/// it). Seen by the team leader and their sales manager.
model TeamMeeting {
  id           String   @id @default(cuid())
  teamLeaderId String
  teamLeader   User     @relation("TeamMeetingBy", fields: [teamLeaderId], references: [id], onDelete: Cascade)
  /// The calendar day the meeting is for (date-only), so there is one per day.
  meetingDate  DateTime @db.Date
  photoUrl     String
  latitude     Float
  longitude    Float
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([teamLeaderId, meetingDate])
}

model BuildingDetails {
  id           String   @id @default(cuid())
  buildingId   String   @unique
  building     Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  wings        Int?
  floors       Int?
  homePass     Int?
  buildingType String?
  remarks      String?
}

model Permission {
  id               String    @id @default(cuid())
  buildingId       String    @unique
  building         Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  amountPaid       Decimal?  @db.Decimal(12, 2)
  permissionStatus String?
  permissionDate   DateTime?
  renewalDate      DateTime?
  ownerName        String?
  ownerMobile      String?
  documentUrl      String?
  /// Society-permission capture (Permission Executive). 'PAYMENT' | 'DEMO'.
  societyOffer     String?
  /// 'ONE_TIME' | 'RECURRING' (when societyOffer is PAYMENT).
  paymentType      String?
  /// Demo connections offered (when societyOffer is DEMO).
  demoCount        Int?
}

/// One entry in a PERMISSION building's history: the first add, a visit
/// update, or a details edit. Append-only; the remark is compulsory.
model PermissionVisit {
  id           String   @id @default(cuid())
  buildingId   String
  building     Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation("PermissionVisitBy", fields: [userId], references: [id], onDelete: SetNull)
  remark       String
  /// Permission status before / after, when this entry changed it.
  statusBefore String?
  statusAfter  String?
  /// Fields a details edit changed, e.g. contact, offer, photos.
  changes      String[] @default([])
  /// 'ADDED' | 'VISIT' | 'EDIT' | 'SUBMITTED' | 'WITHDRAWN' | 'APPROVED' | 'REJECTED' |
  /// 'SURVEY_SUBMITTED' | 'SURVEY_EDITED' | 'MATERIALS_APPROVED' | 'MATERIALS_REJECTED' | 'MARKED_LIVE'
  kind         String
  createdAt    DateTime @default(now())

  @@index([buildingId, createdAt])
}

/// Society permissions, phase 3: the zone surveyor's site survey + material
/// request for an APPROVED society. One per building. JSON shapes and the
/// material catalogue: src/lib/society-materials.js.
model SocietySurvey {
  id            String    @id @default(cuid())
  buildingId    String    @unique
  building      Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  /// 'DRAFT' | 'SUBMITTED' | 'APPROVED' | 'REJECTED'
  status        String
  /// { nameOk, nameCorrection?, wingsOk, homePassOk, note? }
  checks        Json      @default("{}")
  /// [{ name, floors, flatsPerFloor, shafts, homePass }]
  wings         Json      @default("[]")
  /// [{ from, to, method: 'AERIAL' | 'UNDERGROUND' | 'TRAY', meters? }]
  links         Json      @default("[]")
  /// { <catalogue key>: qty } — zero quantities are not stored
  materials     Json      @default("{}")
  /// The last reject reason — kept until the materials are approved.
  rejectReason  String?
  submittedAt   DateTime?
  submittedById String?
  submittedBy   User?     @relation("SocietySurveySubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decidedById   String?
  decidedBy     User?     @relation("SocietySurveyDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

/// The decision-maker an acquisition agent met at the building.
model BuildingContact {
  id               String             @id @default(cuid())
  buildingId       String             @unique
  building         Building           @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  contactName      String
  contactPhone     String
  contactEmail     String?
  designation      ContactDesignation
  /// Free text when designation is OTHER.
  designationOther String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Photo {
  id         String    @id @default(cuid())
  buildingId String
  building   Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  type       PhotoType
  url        String
  createdAt  DateTime  @default(now())
}

/// Append-only audit trail. User fields are denormalized snapshots (no FK)
/// so log entries survive user deletion/rename.
model SystemLog {
  id           String   @id @default(cuid())
  userId       String?
  userName     String?
  userEmail    String?
  userRole     String?
  module       String
  action       String
  description  String
  oldValue     Json?
  newValue     Json?
  recordId     String?
  buildingId   String?
  ipAddress    String?
  device       String?
  browser      String?
  os           String?
  requestUrl   String
  httpMethod   String
  status       String
  statusCode   Int?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([module, action])
}

// ---------------------------------------------------------------------------
// Partner network — external referral partners recruited by our employees.
// Deliberately separate from User: different identity, different auth,
// different lifecycle, commercial terms later. See partner-network.md §2.2.
// ---------------------------------------------------------------------------

enum PartnerType {
  AGENT
  SOCIETY_REPRESENTATIVE
  RETAIL_SHOP
  DSA
}

enum PartnerStatus {
  /// Account created, documents not uploaded yet.
  REGISTERED
  /// Documents in, waiting on an admin.
  PENDING_APPROVAL
  /// Cleared — the only state that may create leads.
  APPROVED
  /// Turned away with a reason; may re-upload.
  REJECTED
  /// Switched off by an admin; cannot even sign in.
  SUSPENDED
}

enum PartnerDocumentType {
  AADHAAR
  PAN
  CANCELLED_CHEQUE
}

model Partner {
  id                String        @id @default(cuid())
  name              String
  type              PartnerType
  /// Company / society / shop / firm name, depending on the type.
  companyName       String?
  /// THE identity. The one thing this audience always knows and never
  /// forgets — see partner-network.md §0.
  mobile            String        @unique
  /// Optional: many partners have no email at all.
  email             String?       @unique
  status            PartnerStatus @default(REGISTERED)
  /// EN | HI | MR — the portal speaks their language.
  preferredLanguage String        @default("EN")

  /// The employee who recruited them. Commission will depend on this, so it
  /// is recorded whether it came from an invite link or an admin mapping.
  onboardedById String?
  onboardedBy   User?    @relation("PartnerOnboardedBy", fields: [onboardedById], references: [id], onDelete: SetNull)
  onboardedAt   DateTime @default(now())

  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  documents         PartnerDocument[]
  bankAccount       PartnerBankAccount?
  invite            PartnerInvite?
  leads             Lead[]
  earnings          PartnerEarning[]
  payments          PartnerPayment[]
  introductionsMade PartnerReferral[] @relation("PartnerReferralBy")
  introducedAs      PartnerReferral?  @relation("PartnerReferralJoined")
  coverageRequests  CoverageRequest[]
  pushTokens        PartnerPushToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([onboardedById])
}

/// A phone that can receive this partner's push notifications. One partner
/// may have several; a token re-registered by another partner moves to them.
model PartnerPushToken {
  id         String   @id @default(cuid())
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  /// "ExponentPushToken[...]"
  token      String   @unique
  /// android | ios
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([partnerId])
}

model PartnerDocument {
  id         String              @id @default(cuid())
  partnerId  String
  partner    Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type       PartnerDocumentType
  url        String
  uploadedAt DateTime            @default(now())

  /// One current document of each type per partner; re-upload replaces it.
  @@unique([partnerId, type])
}

/// A one-use invite link. The token is stored HASHED — a leaked database
/// dump must not hand anyone a working invite.
model PartnerInvite {
  id        String @id @default(cuid())
  tokenHash String @unique

  /// The introduction this link was raised for, when it came from one.
  /// Not unique: a link that expires is replaced by a new one, and the old
  /// row stays as history. The live invite is the newest unrevoked one.
  referralId String?
  referral   PartnerReferral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  employeeId String
  employee   User      @relation("PartnerInvitesIssued", fields: [employeeId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  usedById   String?   @unique
  usedBy     Partner?  @relation(fields: [usedById], references: [id], onDelete: SetNull)
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId])
  @@index([referralId])
}

/// A pending one-time code: hashed, short-lived, attempt-capped.
model OtpChallenge {
  id         String    @id @default(cuid())
  identifier String
  channel    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, createdAt])
}

/// How the searched building lined up with our registry, at the moment the
/// lead was captured. Green, amber, red.
enum BuildingMatch {
  /// We serve it today.
  LIVE
  /// Surveyed and viable, not lit yet — "coming soon".
  IN_REGISTRY
  /// We hold nothing there. The lead is still worth having.
  NOT_FOUND
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  CONVERTED
  NOT_INTERESTED
  UNREACHABLE
  /// Someone else referred this customer first; the original keeps the claim.
  DUPLICATE
}

/// A potential customer referred by a partner.
model Lead {
  id String @id @default(cuid())

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  /// SNAPSHOT of the partner's employee at the moment of referral. Not a
  /// live lookup: re-assigning a partner later must never rewrite who
  /// earned the leads they already sent.
  employeeId String?
  employee   User?   @relation("LeadEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  /// The building we matched, when we hold one.
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  customerName    String
  customerMobile  String
  customerEmail   String?
  address         String?
  note            String?
  /// What speed they asked for: 100 / 200 / 300 / 400.
  requirementMbps Int?

  /// What the partner actually searched for. Kept even when we matched
  /// nothing, so an unknown building can be reconciled later rather than lost.
  searchedPlaceId   String?
  searchedPlaceName String?
  buildingMatch     BuildingMatch?

  status        LeadStatus @default(NEW)
  duplicateOfId String?
  duplicateOf   Lead?      @relation("LeadDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Lead[]     @relation("LeadDuplicate")

  events     LeadStatusEvent[]
  calls      LeadCall[]
  /// When this lead asked to be called back. Kept on the lead, not derived
  /// from the last call, so "who is due today" is one indexed query.
  nextCallAt DateTime?
  earning    PartnerEarning?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([partnerId])
  @@index([employeeId])
  @@index([status])
  @@index([customerMobile])
  @@index([nextCallAt])
}

/// Every status change, with who and when. Commission may one day depend on
/// CONVERTED, and that history cannot be reconstructed after the fact.
model LeadStatusEvent {
  id         String      @id @default(cuid())
  leadId     String
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus LeadStatus?
  toStatus   LeadStatus
  byUserId   String?
  note       String?
  createdAt  DateTime    @default(now())

  @@index([leadId])
}

/// A building a partner asked about that we could not serve. Not a lead —
/// a demand signal for network planning.
model CoverageRequest {
  id                String   @id @default(cuid())
  partnerId         String?
  partner           Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  placeId           String?
  name              String?
  latitude          Float
  longitude         Float
  matchedBuildingId String?
  createdAt         DateTime @default(now())

  @@index([placeId])
  @@index([createdAt])
}

enum BillingPeriod {
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

/// What a partner earns for one connection, by speed and billing period.
/// A table rather than constants: prices change, and a hardcoded number
/// becomes a bug the day they do (partner-network.md §3.2).
model RateCard {
  id            String        @id @default(cuid())
  speedMbps     Int
  billingPeriod BillingPeriod
  /// Rupees, per customer.
  amount        Int
  effectiveFrom DateTime      @default(now())
  createdAt     DateTime      @default(now())

  @@unique([speedMbps, billingPeriod, effectiveFrom])
  @@index([effectiveFrom])
}

/// What a partner is owed for one converted lead.
///
/// One row per converted lead, and the lead id is unique: converting the same
/// customer twice must never pay twice. Every figure is a SNAPSHOT taken at
/// conversion - the speed and period the customer actually bought, and the
/// rate in force that day - so a later price change cannot rewrite what was
/// already earned, and the employee attribution survives re-assignment.
model PartnerEarning {
  id String @id @default(cuid())

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  /// One earning per lead. The whole no-double-pay rule is this constraint.
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Snapshot of the partner's employee, mirroring Lead.employeeId.
  employeeId String?
  employee   User?   @relation("EarningEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  /// What the customer ACTUALLY took, which is not always what they asked for.
  speedMbps     Int
  billingPeriod BillingPeriod
  /// Rupees, snapshotted from the rate card at conversion.
  amount        Int

  /// The month this counts towards. Set from the conversion, not from a live
  /// clock, so a backdated correction lands in the month it belongs to.
  earnedAt DateTime @default(now())

  status    EarningStatus   @default(AWAITING_PAYMENT)
  /// The payment that settled this, when one was recorded.
  paymentId String?
  payment   PartnerPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paidAt    DateTime?
  paidById  String?
  paidBy    User?           @relation("EarningPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, earnedAt])
  @@index([employeeId])
  @@index([status])
}

enum EarningStatus {
  AWAITING_PAYMENT
  PAID
}

/// Someone a partner has introduced who could also send us customers
/// (partner-network.md §7).
///
/// Deliberately NOT a Partner row: these people have agreed to nothing yet,
/// and half of them never will. Turning an introduction into an account is a
/// separate act with its own consent.
///
/// §7.1 leaves who follows up, whether the referrer earns anything, and
/// whether chains exist all open. None of that blocks capture — losing the
/// introduction is worse than not yet paying for it — so the record carries
/// what a later commission rule would need (`joinedPartnerId`) and decides
/// nothing.
model PartnerReferral {
  id String @id @default(cuid())

  /// Who made the introduction.
  referredById String
  referredBy   Partner @relation("PartnerReferralBy", fields: [referredById], references: [id], onDelete: Cascade)

  /// SNAPSHOT of the referring partner's employee at the moment of
  /// introduction — the §7.1 proposal is that follow-up lands with them, and
  /// re-assigning the partner later must not move work already queued.
  employeeId String?
  employee   User?   @relation("PartnerReferralEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  name   String
  type   PartnerType
  mobile String
  email  String?
  note   String?

  status PartnerReferralStatus @default(NEW)

  /// Set when this introduction actually became a partner. Kept so a future
  /// referral reward has the link it needs without re-deriving it from a
  /// mobile number.
  joinedPartnerId String?  @unique
  joinedPartner   Partner? @relation("PartnerReferralJoined", fields: [joinedPartnerId], references: [id], onDelete: SetNull)

  /// Invite links raised for this person, newest last.
  invites PartnerInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referredById])
  @@index([employeeId])
  @@index([status])
  @@index([mobile])
}

enum PartnerReferralStatus {
  NEW
  CONTACTED
  JOINED
  DECLINED
}

/// One payment to a partner for one month.
///
/// The entry accounts actually make: how much moved, by what route, and the
/// reference the partner can check against their bank. Marking a month "paid"
/// without those is a claim nobody can verify.
model PartnerPayment {
  id String @id @default(cuid())

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  /// The month being settled, as YYYY-MM.
  month String

  /// What that month came to when this was recorded — a SNAPSHOT. If an
  /// earning is added or corrected later, the payment must still show what
  /// was owed at the time rather than silently disagreeing with itself.
  amountOwed Int
  /// What actually left the account. Usually the same; kept separate so a
  /// part payment or a rounding difference is visible instead of lost.
  amountPaid Int

  method    PaymentMethod
  /// UTR, transaction id or cheque number. Optional only for cash.
  reference String?
  note      String?

  /// When the money moved — not when the entry was typed, which is createdAt.
  paidOn DateTime

  recordedById String?
  recordedBy   User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  /// The earnings this payment settled.
  earnings PartnerEarning[]

  createdAt DateTime @default(now())

  @@index([partnerId, month])
  @@index([paidOn])
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CASH
  CHEQUE
  OTHER
}

/// One phone call to a lead.
///
/// The record is written when the call ENDS, with the outcome — a call with
/// no outcome tells the next person nothing, and a row created at "start"
/// would dangle forever whenever a browser tab closes mid-call.
model LeadCall {
  id String @id @default(cuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  byUserId String?
  by       User?   @relation("LeadCallBy", fields: [byUserId], references: [id], onDelete: SetNull)

  startedAt       DateTime
  endedAt         DateTime
  /// Seconds, stored rather than recomputed so a clock change cannot rewrite
  /// how long a past call took.
  durationSeconds Int

  outcome    CallOutcome
  /// Set only for CALL_LATER — when they asked to be called back.
  callbackAt DateTime?
  note       String?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([byUserId])
}

enum CallOutcome {
  INTERESTED
  CALL_LATER
  NOT_REACHABLE
  WRONG_NUMBER
}

/// Where a partner's commission is paid. One per partner. The account number
/// is encrypted by the app (lib/field-cipher.js); only the last 4 are clear.
model PartnerBankAccount {
  id                String   @id @default(uuid())
  partnerId         String   @unique
  partner           Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  accountHolderName String
  accountNumberEnc  String
  accountLast4      String
  ifsc              String
  bankName          String?
  branchName        String
  /// The staff member who last edited it; null when the partner saved it.
  updatedById       String?
  updatedBy         User?    @relation("PartnerBankEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// An APK partners can be asked to install. The file lives in R2 at apkKey.
model AppRelease {
  id          String   @id @default(cuid())
  version     String   @unique
  apkKey      String
  notes       String?
  createdById String?
  createdBy   User?    @relation("AppReleaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

/// One row (id 'singleton'): the oldest app version still allowed to run.
model AppReleaseSetting {
  id                      String   @id @default("singleton")
  minimumSupportedVersion String   @default("0.0.0")
  updatedById             String?
  updatedAt               DateTime @default(now()) @updatedAt
}

/// One planned visit: this person, this building, this IST day (spec 2026-10-07).
model VisitTask {
  id          String      @id @default(cuid())
  assigneeId  String
  assignee    User        @relation("VisitTaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  buildingId  String
  building    Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  taskDate    DateTime    @db.Date
  startTime   String?
  endTime     String?
  uploadId    String?
  upload      TaskUpload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  /// Tasks made from one sheet row share it (series edits); null = a one-off.
  seriesId    String?
  createdById String?
  createdBy   User?       @relation("VisitTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  @@index([assigneeId, taskDate])
  @@index([taskDate])
  @@index([seriesId, taskDate])
}

/// One plan import.
model TaskUpload {
  id            String      @id @default(cuid())
  uploadedById  String?
  uploadedBy    User?       @relation("TaskUploadBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  fromDate      DateTime    @db.Date
  toDate        DateTime    @db.Date
  assigneeCount Int
  created       Int
  replaced      Int
  assigned      Int
  fileName      String?
  createdAt     DateTime    @default(now())
  tasks         VisitTask[]
}
