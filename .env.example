# ─── Backend environment ─────────────────────────────────────────────────────
# Copy to .env and fill real values. Never commit .env.

# Database. With docker compose this is set automatically to the `db` service;
# for a managed Postgres (RDS / Neon / Cloud SQL) put the full URL here.
DATABASE_URL="postgresql://user:password@localhost:5432/isp_feasibility"

# Auth. MUST be a long, random, unique string in production (24+ chars).
# Generate one: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Server. PORT is the port the app listens on INSIDE the container (leave 4000).
# API_PUBLISH is the host bind:port docker exposes — it MUST be unique on the VM.
# Already used on this VM: 5001, 5002, 5003, 5432, 5500. We default to 5004.
# Localhost bind (recommended, behind a reverse proxy); use 0.0.0.0:5004 for
# direct public access.
PORT=4000
API_PUBLISH=127.0.0.1:5004
NODE_ENV=production

# Public base URL of THIS backend — used to build stored file URLs, so it must
# be the externally reachable address (e.g. https://api.yourdomain.com).
APP_URL="https://api.yourdomain.com"

# Allowed browser origins (your frontend). Comma-separated, or * to allow all.
CORS_ORIGIN="https://app.yourdomain.com"

# File storage. 'local' writes to UPLOADS_DIR (persist it with a volume).
# Swap to an S3/R2 driver later — the StorageProvider abstraction is ready.
STORAGE_DRIVER=local
UPLOADS_DIR=uploads

# Duplicate-detection radius (metres)
DUPLICATE_RADIUS_METERS=100

# First-run seed (docker-entrypoint). Creates the initial admin below.
# Set true on the FIRST deploy only.
RUN_SEED=false
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="change-this-strong-password"

# ─── docker compose only ─────────────────────────────────────────────────────
POSTGRES_USER=isp
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=isp_feasibility
